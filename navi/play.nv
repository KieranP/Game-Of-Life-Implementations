use std.time.DateTime;
use std.env;
use std.io;

const WORLD_WIDTH = 150;
const WORLD_HEIGHT = 40;
const CLEAR_SCREEN = "\u{001b}[?2026h\u{001b}[H\u{001b}[2J";
const SHOW_SCREEN = "\u{001b}[?2026l";

// Navi has no infinity literal or float max constant
const INFINITY: float = 1.0 / 0.0;

struct Play {}

impl Play {
  fn run() throws {
    let world = try World.new(
      WORLD_WIDTH,
      WORLD_HEIGHT,
    );

    let minimal = env.get("MINIMAL") != nil;

    if (!minimal) {
      println(world.render());
    }

    let total_tick = 0;
    let lowest_tick = INFINITY;
    let total_render = 0;
    let lowest_render = INFINITY;

    while(true) {
      const tick_start = DateTime.now_utc();
      world.dotick();
      const tick_finish = DateTime.now_utc();
      const tick_time = tick_finish.sub(tick_start).nanoseconds();
      total_tick += tick_time;
      lowest_tick = lowest_tick.min(tick_time as float);
      const avg_tick = (total_tick as float / world.tick as float);

      const render_start = DateTime.now_utc();
      const rendered = world.render();
      const render_finish = DateTime.now_utc();
      const render_time = render_finish.sub(render_start).nanoseconds();
      total_render += render_time;
      lowest_render = lowest_render.min(render_time as float);
      const avg_render = (total_render as float / world.tick as float);

      if (!minimal) {
        print(CLEAR_SCREEN);
      }

      // print instead of println, as println space-joins its values and the newline
      print(
        `#${world.tick}` +
        ` - World Tick (L: ${Play._f(lowest_tick)}; A: ${Play._f(avg_tick)})` +
        ` - Rendering (L: ${Play._f(lowest_render)}; A: ${Play._f(avg_render)})` +
        "\n"
      );

      if (!minimal) {
        print(rendered + SHOW_SCREEN);
      }

      // stdout is buffered and the frame ends with SHOW_SCREEN (no trailing newline), so without
      // an explicit flush the terminal won't commit the synchronized update until the next tick.
      try io.stdout().flush();
    }
  }

  fn _f(value: float): string {
    // nanoseconds -> milliseconds, padded to 3 decimal places
    let thousandths = (value / 1_000.0).round() as int;
    let frac = `${thousandths % 1000}`;
    return `${thousandths / 1000}.${"0".repeat(3 - frac.len())}${frac}`;
  }
}

fn main() throws {
  try Play.run();
}
